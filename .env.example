# =============================================================================
# QuizCloud – Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and will NOT be committed.
#
# VITE_API_BASE_URL
#   The invoke URL of your Amazon API Gateway HTTP API, WITHOUT a trailing slash.
#   Find it in the AWS Console → API Gateway → QuizApp_API → Invoke URL.
#   Example format:  https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
#
# This is the ONLY variable required to connect the frontend to AWS.
# =============================================================================

VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

